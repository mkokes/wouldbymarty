{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "jsx-a11y", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "@testing-library/jest-dom/vitest"]
      }
    ]
  },
  "env": {
    "browser": true,
    "es2024": true
  },
  "overrides": [
    {
      "files": ["scripts/**", "public/sw.js"],
      "env": {
        "node": true,
        "serviceworker": true
      }
    }
  ],
  "ignorePatterns": ["dist/**", "src/data/**", "public/instagram/**"]
}
